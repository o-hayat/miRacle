{
  "name": "miracle-research",
  "version": "0.2.0",
  "private": true,
  "description": "Explainable human pre-miRNA candidate triage",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/build-worker.mjs && next dev",
    "build": "node scripts/build-worker.mjs && next build && node scripts/check-assets.mjs",
    "preview": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit.test.ts tests/parity.test.ts",
    "test:browser": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "deploy": "vercel"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^60.1.3"
  },
  "type": "module",
  "packageManager": "bun@1.3.11"
}
